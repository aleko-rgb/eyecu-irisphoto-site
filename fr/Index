<script>
const navEl=document.getElementById('nav');window.addEventListener('scroll',()=>{navEl.classList.toggle('scrolled',window.scrollY>40);});
const navToggle=document.getElementById('navToggle'),navLinks=document.getElementById('navLinks'),langWrap=document.getElementById('langMobileWrap');
