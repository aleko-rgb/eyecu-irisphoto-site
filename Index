<!DOCTYPE html>
<html lang="pl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Zdjęcie tęczówki oka Poznań z dojazdem — biżuteria, WallArt | EYE C U® Iris Photo</title>
<meta name="description" content="Makrofotografia tęczówki oka w Poznaniu i Wielkopolsce — z dojazdem do Ciebie. Biżuteria ze zdjęciem tęczówki, WallArt, eventy, zwierzęta. Bon podarunkowy. EYE C U® Iris Photo.">
<link rel="canonical" href="https://irisphoto.eye-c-u.eu/pl/">
<link rel="alternate" hreflang="pl" href="https://irisphoto.eye-c-u.eu/pl/">
<link rel="alternate" hreflang="en" href="https://irisphoto.eye-c-u.eu/en/">
<link rel="alternate" hreflang="fr" href="https://irisphoto.eye-c-u.eu/fr/">
<link rel="alternate" hreflang="x-default" href="https://irisphoto.eye-c-u.eu/pl/">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
<style>
:root{--ink:#0e0e0e;--paper:#ffffff;--bordeaux:#6B1E2E;--gold:#A9805A;--grey:#767676;--line:rgba(0,0,0,0.10);}
*{margin:0;padding:0;box-sizing:border-box;}
html{scroll-behavior:smooth;}
body{background:var(--paper);color:var(--ink);font-family:'Jost',sans-serif;font-weight:300;overflow-x:hidden;line-height:1.7;}
h1,h2,h3,.serif{font-family:'Cormorant Garamond',serif;font-weight:400;}
a{color:inherit;text-decoration:none;}
img{display:block;max-width:100%;}
@media(prefers-reduced-motion:reduce){*{animation-duration:.01ms!important;transition-duration:.01ms!important;}}

/* NAV */
nav{position:fixed;top:0;left:0;right:0;z-index:100;display:flex;align-items:center;justify-content:space-between;padding:22px 5vw;transition:background .5s,padding .4s,box-shadow .4s;}
nav.scrolled{background:rgba(255,255,255,0.96);backdrop-filter:blur(10px);padding:13px 5vw;box-shadow:0 1px 0 var(--line);}
.logo{display:flex;align-items:center;gap:9px;font-family:'Cormorant Garamond',serif;font-size:1.05rem;letter-spacing:.28em;text-transform:uppercase;}
.logo img{height:34px;width:auto;flex:none;}
.nav-right{display:flex;align-items:center;gap:1.8rem;}
.nav-links{display:flex;align-items:center;gap:1.8rem;font-size:.75rem;letter-spacing:.08em;text-transform:uppercase;}
.nav-links a{position:relative;padding-bottom:3px;}
.nav-links a::after{content:'';position:absolute;left:0;bottom:0;width:0;height:1px;background:var(--bordeaux);transition:width .3s;}
.nav-links a:hover::after{width:100%;}
.lang-bar{display:flex;gap:.45rem;font-size:.7rem;letter-spacing:.1em;align-items:center;}
.lang-bar span{color:rgba(0,0,0,.2);}
.lang-bar a{transition:color .2s;}
.lang-bar a.active{color:var(--bordeaux);font-weight:500;}
.btn{display:inline-block;font-family:'Jost',sans-serif;font-weight:500;font-size:.75rem;letter-spacing:.08em;text-transform:uppercase;padding:.7rem 1.3rem;cursor:pointer;border:1px solid transparent;transition:opacity .25s,background .25s;}
.btn:hover{opacity:.86;}
.btn-solid{background:var(--bordeaux);color:#fff;border-color:var(--bordeaux);}
.btn-ghost{border-color:var(--ink);color:var(--ink);}
.btn-ghost-light{border-color:rgba(255,255,255,.7);color:#fff;}
.btn-ghost-light:hover{background:rgba(255,255,255,.08);opacity:1;}
.nav-toggle{display:none;background:none;border:none;font-size:1.4rem;cursor:pointer;color:var(--ink);}
@media(max-width:900px){
  .nav-links{position:fixed;inset:0;background:var(--ink);color:var(--paper);flex-direction:column;justify-content:center;align-items:center;gap:1.8rem;font-size:1rem;opacity:0;pointer-events:none;transition:opacity .4s;z-index:99;overflow-y:auto;}
  .nav-links.open{opacity:1;pointer-events:all;}
  .nav-links a::after{background:#fff;}
  .nav-toggle{display:block;z-index:110;}
  .lang-desktop{display:none;}
  .lang-mobile-wrap{display:flex!important;position:fixed;bottom:2rem;left:0;right:0;justify-content:center;z-index:110;opacity:0;pointer-events:none;transition:opacity .4s;}
  .lang-mobile-wrap.open{opacity:1;pointer-events:all;}
}
@media(min-width:901px){.lang-mobile-wrap{display:none;}}

/* HERO */
.hero{position:relative;min-height:100svh;overflow:hidden;display:flex;flex-direction:column;justify-content:flex-end;}
.hero-bg{position:absolute;inset:0;z-index:0;background:radial-gradient(ellipse 65% 85% at 62% 50%,rgba(107,30,46,.22),transparent 65%),radial-gradient(ellipse 85% 55% at 28% 38%,rgba(169,128,90,.1),transparent 58%),linear-gradient(155deg,#0e0e0e 0%,#1c0e12 42%,#0e0a0c 100%);}
.iris-ring{position:absolute;z-index:1;top:50%;left:60%;transform:translate(-50%,-50%);width:min(66vw,540px);height:min(66vw,540px);border-radius:50%;border:1px solid rgba(169,128,90,.16);box-shadow:0 0 0 clamp(20px,4vw,42px) rgba(107,30,46,.07),0 0 0 clamp(42px,8.5vw,84px) rgba(169,128,90,.035),inset 0 0 70px rgba(107,30,46,.16);animation:irisBreath 8s ease-in-out infinite;pointer-events:none;}
.iris-ring::before{content:'';position:absolute;inset:12%;border-radius:50%;border:1px solid rgba(169,128,90,.1);box-shadow:inset 0 0 36px rgba(107,30,46,.1);}
.iris-ring::after{content:'';position:absolute;inset:39%;border-radius:50%;background:radial-gradient(circle,rgba(14,14,14,.92) 40%,rgba(107,30,46,.22) 100%);box-shadow:0 0 20px rgba(107,30,46,.28);}
@keyframes irisBreath{0%,100%{transform:translate(-50%,-50%) scale(1);}50%{transform:translate(-50%,-50%) scale(1.016);}}
@media(max-width:860px){.iris-ring{top:28%;left:50%;width:76vw;height:76vw;}}
.hero-content{position:relative;z-index:2;padding:0 5vw 5rem;max-width:600px;color:#fff;}
.hero-eyebrow{font-size:.73rem;letter-spacing:.22em;text-transform:uppercase;color:var(--gold);margin-bottom:1rem;opacity:0;animation:riseIn 1s ease .4s forwards;}
.hero h1{font-size:clamp(2.4rem,5.5vw,4.6rem);font-weight:300;line-height:1.06;letter-spacing:.02em;color:#fff;opacity:0;animation:riseIn 1s ease .65s forwards;}
.hero h1 em{font-style:italic;color:var(--gold);}
.hero-sub{margin-top:1.4rem;max-width:46ch;font-size:.97rem;line-height:1.72;color:rgba(255,255,255,.75);opacity:0;animation:riseIn 1s ease .9s forwards;}
.hero-ctas{margin-top:2.2rem;display:flex;gap:.9rem;flex-wrap:wrap;opacity:0;animation:riseIn 1s ease 1.1s forwards;}
.scroll-cue{position:absolute;bottom:1.8rem;right:5vw;z-index:2;display:flex;flex-direction:column;align-items:center;gap:7px;opacity:0;animation:riseIn 1s ease 1.4s forwards;}
.stem{width:1px;height:34px;background:rgba(255,255,255,.25);position:relative;overflow:hidden;}
.stem::after{content:'';position:absolute;top:-100%;left:0;width:100%;height:100%;background:var(--gold);animation:stemDrop 2.4s ease-in-out infinite;}
@keyframes stemDrop{0%{top:-100%;}65%{top:100%;}100%{top:100%;}}
@keyframes riseIn{from{opacity:0;transform:translateY(15px);}to{opacity:1;transform:translateY(0);}}

/* SECTIONS */
section{padding:5rem 5vw;}
.section-head{max-width:640px;margin-bottom:2.8rem;}
.eyebrow{font-size:.73rem;letter-spacing:.2em;text-transform:uppercase;color:var(--bordeaux);display:flex;align-items:center;gap:12px;margin-bottom:1rem;}
.eyebrow::before{content:'';width:28px;height:1px;background:var(--bordeaux);}
.section-head h2{font-size:clamp(1.9rem,3.8vw,3rem);line-height:1.12;font-weight:300;}
.section-head p{margin-top:1rem;color:var(--grey);font-size:.95rem;max-width:54ch;line-height:1.75;}
.reveal{opacity:0;transform:translateY(24px);transition:opacity .9s ease,transform .9s ease;}
.reveal.visible{opacity:1;transform:none;}

/* O NAS — steps grid */
.steps-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:var(--line);border:1px solid var(--line);}
@media(max-width:640px){.steps-grid{grid-template-columns:1fr;}}
.step-item{background:var(--paper);padding:2.6rem 2.2rem;}
.step-num{font-family:'Cormorant Garamond',serif;font-style:italic;color:var(--gold);font-size:1.4rem;margin-bottom:.7rem;display:block;}
.step-item h3{font-size:1.18rem;font-weight:400;margin-bottom:.5rem;}
.step-item p{color:var(--grey);font-size:.92rem;line-height:1.75;}

/* GALERIA */
.gallery-mosaic{display:grid;grid-template-columns:1fr 1.35fr 1fr;gap:3px;background:var(--line);}
@media(max-width:640px){.gallery-mosaic{grid-template-columns:1fr 1fr;}}
.gallery-mosaic figure{overflow:hidden;aspect-ratio:3/4;background:#111;position:relative;}
.gallery-mosaic figure:nth-child(2){aspect-ratio:2/3;}
.gallery-mosaic img{width:100%;height:100%;object-fit:cover;transition:transform 1.2s cubic-bezier(.16,.84,.44,1);}
.gallery-mosaic figure:hover img{transform:scale(1.06);}
.iris-ph{width:100%;height:100%;display:flex;align-items:center;justify-content:center;}
.gallery-note{margin-top:1.3rem;font-family:'Cormorant Garamond',serif;font-style:italic;color:var(--grey);font-size:.93rem;}

/* PRODUKTY */
.product-cat-title{font-family:'Cormorant Garamond',serif;font-size:1.25rem;font-weight:400;margin-bottom:1.4rem;padding-bottom:.8rem;border-bottom:1px solid var(--line);display:flex;align-items:center;gap:1rem;}
.product-cat-title::before{content:'';width:22px;height:1px;background:var(--bordeaux);}
.products-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:1px;background:var(--line);border:1px solid var(--line);margin-bottom:3rem;}
.product-card{background:var(--paper);padding:1.7rem 1.4rem;}
.product-name{font-size:.92rem;font-weight:400;line-height:1.4;}
.product-sub{font-size:.78rem;color:var(--grey);margin-top:.2rem;}
.product-price{font-family:'Cormorant Garamond',serif;font-style:italic;color:var(--gold);font-size:1.2rem;margin-top:.7rem;}

/* DARK SECTION */
.section-dark{background:var(--ink);color:#fff;}
.section-dark .eyebrow{color:var(--gold);}
.section-dark .eyebrow::before{background:var(--gold);}
.section-dark .section-head h2{color:#fff;}
.section-dark .section-head p{color:rgba(255,255,255,.6);}
.dark-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.1);}
@media(max-width:640px){.dark-grid{grid-template-columns:1fr;}}
.dark-card{background:var(--ink);padding:2.2rem 1.8rem;}
.dark-card h3{color:#fff;font-size:1.08rem;font-weight:400;margin-bottom:.6rem;}
.dark-card p{color:rgba(255,255,255,.55);font-size:.91rem;line-height:1.75;}
.feat-list{list-style:none;display:flex;flex-direction:column;gap:.85rem;margin-top:2.4rem;}
.feat-list li{color:rgba(255,255,255,.7);font-size:.93rem;padding-left:1.4rem;position:relative;}
.feat-list li::before{content:'–';position:absolute;left:0;color:var(--gold);}

/* ZWIERZETA */
.animals-layout{display:grid;grid-template-columns:1.1fr 1fr;gap:4.5rem;align-items:start;}
@media(max-width:720px){.animals-layout{grid-template-columns:1fr;gap:2.5rem;}}
.reason-list{display:flex;flex-direction:column;gap:1.5rem;margin-top:.5rem;}
.reason{display:flex;gap:1.1rem;}
.reason-num{font-family:'Cormorant Garamond',serif;font-style:italic;color:var(--bordeaux);font-size:1.3rem;flex:none;width:2rem;}
.reason h4{font-size:.98rem;font-weight:400;margin-bottom:.25rem;}
.reason p{color:var(--grey);font-size:.91rem;line-height:1.7;}
.animals-panel{background:#fafafa;border:1px solid var(--line);padding:2.4rem 2rem;}
.animals-panel h3{font-size:1.2rem;font-weight:400;margin-bottom:1rem;}
.animals-panel p{color:var(--grey);font-size:.92rem;line-height:1.75;margin-bottom:1.4rem;}

/* CIEKAWOSTKI */
.facts-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:1px;background:var(--line);border:1px solid var(--line);}
.fact-item{background:var(--paper);padding:2rem 1.8rem;}
.fact-icon{font-size:1.4rem;margin-bottom:.9rem;display:block;}
.fact-item p{color:var(--grey);font-size:.91rem;line-height:1.75;}
.fact-item strong{color:var(--ink);font-weight:500;}

/* BON */
.voucher-layout{display:grid;grid-template-columns:1.15fr 1fr;gap:4rem;align-items:start;}
@media(max-width:720px){.voucher-layout{grid-template-columns:1fr;gap:2.5rem;}}
.voucher-card{background:var(--ink);color:#fff;padding:3rem 2.6rem;position:relative;overflow:hidden;}
.voucher-card::before{content:'';position:absolute;top:-50%;right:-25%;width:280px;height:280px;border-radius:50%;background:radial-gradient(circle,rgba(107,30,46,.4),transparent 70%);pointer-events:none;}
.voucher-card::after{content:'';position:absolute;bottom:-35%;left:-15%;width:200px;height:200px;border-radius:50%;background:radial-gradient(circle,rgba(169,128,90,.14),transparent 70%);pointer-events:none;}
.voucher-eyebrow{font-size:.7rem;letter-spacing:.22em;text-transform:uppercase;color:var(--gold);margin-bottom:.9rem;}
.voucher-card h3{font-size:clamp(1.5rem,3vw,2rem);font-weight:300;line-height:1.15;color:#fff;margin-bottom:.9rem;position:relative;z-index:1;}
.voucher-card p{color:rgba(255,255,255,.65);font-size:.91rem;margin-bottom:1.7rem;position:relative;z-index:1;line-height:1.75;}
.voucher-ctas{display:flex;gap:.8rem;flex-wrap:wrap;position:relative;z-index:1;}
.voucher-details h3{font-size:1.3rem;font-weight:400;margin-bottom:.9rem;}
.voucher-details p{color:var(--grey);font-size:.93rem;margin-bottom:1rem;line-height:1.75;}
.voucher-list{list-style:none;display:flex;flex-direction:column;gap:.5rem;}
.voucher-list li{font-size:.91rem;color:var(--grey);padding-left:1.2rem;position:relative;}
.voucher-list li::before{content:'–';position:absolute;left:0;color:var(--bordeaux);}

/* CONTACT */
.contact-layout{display:grid;grid-template-columns:1.1fr .9fr;gap:4.5rem;align-items:start;}
@media(max-width:720px){.contact-layout{grid-template-columns:1fr;gap:2.5rem;}}
.contact-ctas{margin-top:1.8rem;display:flex;flex-direction:column;gap:.8rem;max-width:260px;}
.contact-note{margin-top:1.3rem;color:var(--grey);font-size:.87rem;line-height:1.7;}
.social-links{margin-top:1.8rem;display:flex;gap:.8rem;flex-wrap:wrap;}
.social-links a{font-size:.75rem;letter-spacing:.08em;text-transform:uppercase;color:var(--bordeaux);border:1px solid var(--bordeaux);padding:.4rem .85rem;transition:background .2s,color .2s;}
.social-links a:hover{background:var(--bordeaux);color:#fff;}
.contact-panel{background:var(--bordeaux);color:#fff;padding:2.8rem 2.4rem;}
.contact-panel h3{font-size:1.45rem;font-weight:300;margin-bottom:.9rem;color:#fff;}
.contact-panel p{color:rgba(255,255,255,.72);font-size:.91rem;margin-bottom:1.6rem;line-height:1.75;}
.contact-line{padding:.72rem 0;border-top:1px solid rgba(255,255,255,.18);display:flex;justify-content:space-between;font-size:.85rem;color:rgba(255,255,255,.85);gap:1rem;flex-wrap:wrap;}
.contact-line:last-child{border-bottom:1px solid rgba(255,255,255,.18);}
.contact-line a{color:#fff;text-decoration:underline;text-underline-offset:3px;}

/* CROSSLINKS */
.crosslinks{background:#fafafa;border-top:1px solid var(--line);}
.crosslinks-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);border:1px solid var(--line);margin-top:2rem;}
@media(max-width:640px){.crosslinks-grid{grid-template-columns:1fr;}}
.crosslink-card{background:var(--paper);padding:2rem 1.8rem;display:flex;flex-direction:column;gap:.6rem;}
.crosslink-card .tag{font-size:.68rem;letter-spacing:.15em;text-transform:uppercase;color:var(--gold);}
.crosslink-card h3{font-size:1.05rem;font-weight:400;}
.crosslink-card p{color:var(--grey);font-size:.88rem;line-height:1.65;flex:1;}
.crosslink-card a.link-arrow{font-size:.75rem;letter-spacing:.08em;text-transform:uppercase;color:var(--bordeaux);display:flex;align-items:center;gap:.5rem;margin-top:.5rem;}
.crosslink-card a.link-arrow::after{content:'→';}

/* FOOTER */
footer{padding:2.6rem 5vw;border-top:1px solid var(--line);text-align:center;color:var(--grey);font-size:.78rem;}
.footer-links{margin-top:.7rem;display:flex;justify-content:center;gap:1.4rem;flex-wrap:wrap;}
footer a{text-decoration:underline;text-underline-offset:3px;color:var(--grey);}
footer a:hover{color:var(--bordeaux);}

/* COOKIE */
#cookieBar{position:fixed;left:0;right:0;bottom:0;z-index:200;background:var(--ink);color:#fff;padding:.9rem 5vw;display:flex;align-items:center;justify-content:space-between;gap:1.4rem;flex-wrap:wrap;font-size:.82rem;box-shadow:0 -2px 12px rgba(0,0,0,.2);}
#cookieBar a{color:#fff;text-decoration:underline;}
a:focus-visible,button:focus-visible{outline:2px solid var(--bordeaux);outline-offset:3px;}
</style>
</head>
<body>

<!-- NAV -->
<nav id="nav">
  <a href="/pl/" class="logo">
    <img src="../images/logo-v2.png" alt="EYE C U Iris Photo logo">
    <span>EYE C U®</span>
  </a>
  <div class="nav-right">
    <div class="nav-links" id="navLinks">
      <a href="#o-nas" onclick="closeMenu()">O EYE C U</a>
      <a href="#galeria" onclick="closeMenu()">Galeria</a>
      <a href="#produkty" onclick="closeMenu()">Produkty</a>
      <a href="#eventy" onclick="closeMenu()">Eventy</a>
