const navToggle=document.getElementById('navToggle'),navLinks=document.getElementById('navLinks'),langWrap=document.getElementById('langMobileWrap');
navToggle.addEventListener('click',()=>{const o=navLinks.classList.toggle('open');navToggle.textContent=o?'✕':'☰';if(langWrap)langWrap.classList.toggle('open',o);});
function closeMenu(){navLinks.classList.remove('open');if(langWrap)langWrap.classList.remove('open');navToggle.textContent='☰';}
const io=new IntersectionObserver(es=>{es.forEach(e=>{if(e.isIntersecting)e.target.classList.add('visible');});},{threshold:0.1});
document.querySelectorAll('.reveal').forEach(el=>io.observe(el));
function getCookie(n){return document.cookie.split('; ').find(r=>r.startsWith(n+'='));}
const bar=document.getElementById('cookieBar');
if(getCookie('eyecu_cookie_ack'))bar.style.display='none';
document.getElementById('cookieAccept').addEventListener('click',()=>{const d=new Date();d.setFullYear(d.getFullYear()+1);document.cookie='eyecu_cookie_ack=1; expires='+d.toUTCString()+'; path=/';bar.style.display='none';});
</script>
</body>
</html>
